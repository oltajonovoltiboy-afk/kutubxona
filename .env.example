# Copy to .env and change all secrets before production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave DB_NAME empty to use local SQLite. For production, configure PostgreSQL:
# DB_NAME=library_db
# DB_USER=library_user
# DB_PASSWORD=change-this-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-mail@example.com
# EMAIL_HOST_PASSWORD=change-this-password
# EMAIL_USE_TLS=1
